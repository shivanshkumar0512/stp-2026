# Copy this file to .env (for `vercel dev`) or set it in the Vercel
# project's Settings -> Environment Variables.
#
# Powers the AI Chatbot, AI Research Brief Generator and AI Survey
# Generator in /api/ai.js, and article summarization for the AI News
# Feed in /api/news.js. Without this key set, those features still
# work using a built-in rule-based demo mode.
ANTHROPIC_API_KEY=

# Optional. Powers live headlines for the AI News Feed (/api/news.js) via
# NewsAPI.org (https://newsapi.org/register — free tier). Without this key
# set, the feed falls back to a curated static demo feed.
NEWS_API_KEY=
